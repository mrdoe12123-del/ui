// Simple Node/Express example (uses Firestore for storage)
require('dotenv').config();
const express = require('express');
const fetch = require('node-fetch'); // npm i node-fetch@2
const { Firestore } = require('@google-cloud/firestore'); // or use firebase-admin
const crypto = require('crypto');

const app = express();
app.use(express.json());

const firestore = new Firestore({ projectId: process.env.GCP_PROJECT_ID }); // or init firebase-admin
const ORANGE_TOKEN_URL = process.env.ORANGE_TOKEN_URL; // e.g. https://api.orange.com/oauth/v3/token or country-specific
const ORANGE_PAYMENT_INIT = process.env.ORANGE_PAYMENT_INIT; // API URL to create payment / webpay init
const ORANGE_PAYMENT_VERIFY = process.env.ORANGE_PAYMENT_VERIFY; // API to verify transaction status
const ORANGE_CLIENT_ID = process.env.ORANGE_CLIENT_ID;
const ORANGE_CLIENT_SECRET = process.env.ORANGE_CLIENT_SECRET;
const MERCHANT_NUMBER = process.env.MERCHANT_NUMBER; // +231770251042 (your number)
const SITE_URL = process.env.SITE_URL; // public site root (for webhooks/redirects)

async function getAccessToken(){
  // OAuth 2 client_credentials
  const res = await fetch(ORANGE_TOKEN_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: `grant_type=client_credentials&client_id=${encodeURIComponent(ORANGE_CLIENT_ID)}&client_secret=${encodeURIComponent(ORANGE_CLIENT_SECRET)}`
  });
  if(!res.ok) throw new Error('token error ' + res.status);
  const j = await res.json();
  return j.access_token;
}

// 1) Create payment request
app.post('/api/payments/initiate', async (req, res) => {
  try{
    const { mediaId, buyerPhone } = req.body;
    const amount = 20; // LD
    const token = await getAccessToken();

    // Example body - adapt to the specific Orange API fields for Liberia
    const body = {
      amount: amount,
      currency: 'LD',            // replace with correct currency code if different
      merchantWallet: MERCHANT_NUMBER,
      customerWallet: buyerPhone, // optional if you want to direct push
      externalId: `${mediaId}_${Date.now()}`,
      description: `Purchase ${mediaId}`
      // ...other fields depending on API (callback url / return url / mode)
    };

    const initRes = await fetch(ORANGE_PAYMENT_INIT, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(body)
    });

    const initJson = await initRes.json();

    // store pending tx in Firestore
    const txRef = firestore.collection('transactions').doc();
    await txRef.set({
      mediaId,
      buyerPhone,
      amount,
      status: 'pending',
      createdAt: new Date(),
      orangePayload: initJson
    });

    return res.json({ ok: true, txId: txRef.id, init: initJson });
  }catch(err){
    console.error(err);
    res.status(500).json({ ok:false, message: err.message });
  }
});

// 2) Webhook endpoint that Orange calls when payment completed
app.post('/api/payments/webhook', async (req, res) => {
  try{
    // (Optional) verify signature if Orange includes one
    // Example: if Orange provides a header X-ORANGE-SIGNATURE, verify here
    // const sig = req.headers['x-orange-signature'];

    const payload = req.body; // adapt to exact webhook shape
    const externalId = payload.externalId || payload.transactionId || payload.reference;

    // Find pending transaction by externalId or other identifier
    const q = await firestore.collection('transactions').where('orangePayload.externalId','==', externalId).get();
    let doc;
    if(!q.empty) doc = q.docs[0];
    else {
      // fallback: search by some received reference
      const q2 = await firestore.collection('transactions').where('orangePayload.transactionReference','==', externalId).get();
      if(!q2.empty) doc = q2.docs[0];
    }
    if(!doc){
      console.warn('transaction not found for externalId', externalId);
      // Optionally create a record
      return res.status(404).send('not found');
    }

    // Verify with Orange status endpoint (recommended)
    const token = await getAccessToken();
    const verifyRes = await fetch(`${ORANGE_PAYMENT_VERIFY}/${payload.transactionId}`, {
      method: 'GET',
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const verifyJson = await verifyRes.json();

    // set confirmed only if verifyJson shows success
    if(verifyJson && verifyJson.status === 'COMPLETED'){
      await doc.ref.update({ status: 'confirmed', confirmedAt: new Date(), verifyJson });
      // also mark media sale / generate a download token etc.
      // example: generate a one-time download token in collection 'downloads'
      const dref = firestore.collection('downloads').doc();
      await dref.set({ mediaId: doc.data().mediaId, txId: doc.id, expiresAt: new Date(Date.now()+1000*60*60), used:false });
      return res.status(200).send('ok');
    } else {
      await doc.ref.update({ status: 'failed', verifyJson });
      return res.status(200).send('ignored');
    }
  }catch(err){
    console.error('webhook error', err);
    return res.status(500).send('error');
  }
});

const port = process.env.PORT || 4000;
app.listen(port, ()=>console.log('Payment backend listening on', port));

